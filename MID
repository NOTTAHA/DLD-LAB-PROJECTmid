% =========================================================
% FILE: lab4_hometask_convolution_sums.m
% Report's loop approach.
% The second result is truncated because k starts at -5.
% =========================================================
clc;
clear;
close all;

n = -5:10;

% 1. u[n] * u[n-3]
x1 = double(n >= 0);
y1 = zeros(1,length(n));

for i = 1:length(n)
    for j = 1:length(n)

        k = n(j);

        if n(i)-k >= 0
            y1(i) = y1(i) ...
                  + x1(j)*double(n(i)-k >= 3);
        end

    end
end

disp('y1 = ');
disp(y1);

% 2. (2^n u[-n+2]) * u[n-3]
x2 = 2.^n .* double(n <= 2);
y2 = zeros(1,length(n));

for i = 1:length(n)
    for j = 1:length(n)

        k = n(j);

        if n(i)-k >= 3
            y2(i) = y2(i) + x2(j);
        end

    end
end

% For the exact infinite-sum result, use this instead:
% y2 = 2.^(min(2,n-3) + 1);

disp('y2 = ');
disp(y2);

% 3. ((1/2)^n u[n-2]) * u[n]
x3 = (1/2).^n .* double(n >= 2);
y3 = zeros(1,length(n));

for i = 1:length(n)
    for j = 1:length(n)

        k = n(j);

        if n(i)-k >= 0
            y3(i) = y3(i) + x3(j);
        end

    end
end

disp('y3 = ');
disp(y3);

figure;

subplot(3,1,1);
stem(n,y1,'filled');
title('y1[n] = u[n] * u[n-3]');
xlabel('n');
ylabel('y1[n]');
grid on;

subplot(3,1,2);
stem(n,y2,'filled');
title('y2[n] = (2^n u[-n+2]) * u[n-3]');
xlabel('n');
ylabel('y2[n]');
grid on;

subplot(3,1,3);
stem(n,y3,'filled');
title('y3[n] = ((1/2)^n u[n-2]) * u[n]');
xlabel('n');
ylabel('y3[n]');
grid on;


% =========================================================
% FILE: lab5_task1_fourier_series.m
% Integration limits below are for T = 2.
% =========================================================
clc;
clear;
close all;

% Basic parameters
fs = 100;
T = 2;
Wo = 2*pi/T;

k = 0:1/fs:10-1/fs;

% Original square wave
y = square(Wo*k,50);

figure;
plot(k,y,'r','LineWidth',2);
axis([-1 12 -2 2]);
xlabel('Time');
ylabel('Amplitude');
title('Original Square Wave');
grid on;

% Fourier coefficients
syms t;

N = 10;

a0 = (1/T)*(int(1,t,0,1) + int(-1,t,1,2));

an = zeros(1,N);
bn = zeros(1,N);

for i = 1:N

    an(i) = (2/T)*double( ...
        int(cos(i*Wo*t),t,0,1) + ...
        int(-cos(i*Wo*t),t,1,2));

    bn(i) = (2/T)*double( ...
        int(sin(i*Wo*t),t,0,1) + ...
        int(-sin(i*Wo*t),t,1,2));

end

% Build Fourier approximation
F = double(a0)*ones(size(k));

for i = 1:N
    F = F + an(i)*cos(i*Wo*k) ...
          + bn(i)*sin(i*Wo*k);
end

% Plot Fourier approximation
figure;
plot(k,F,'g','LineWidth',2);
xlabel('Time');
ylabel('Amplitude');
title('Fourier Series of Square Wave');
grid on;

% Compare both signals
figure;
plot(k,y,'r','LineWidth',3);
hold on;

plot(k,F,'g','LineWidth',1);
axis([-1 12 -2 2]);
xlabel('Time');
ylabel('Amplitude');
title('Fourier Series Approximation of Square Wave');
legend('Original Square Wave','Fourier Approximation');
grid on;

hold off;
