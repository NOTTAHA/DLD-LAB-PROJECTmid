% =========================================================
% FILE: task2function.m
% =========================================================
function y = task2function(x,h)

    Nx = length(x);
    Nh = length(h);

    y = zeros(1,Nx + Nh - 1);

    for i = 1:Nx
        for j = 1:Nh
            y(i+j-1) = y(i+j-1) + x(i)*h(j);
        end
    end

end


